{
  "name": "@inova/desktop",
  "version": "0.3.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "electron-vite build && vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w node-pty",
    "pack:mac": "node scripts/package.mjs --platform darwin --arch arm64",
    "pack:win": "node scripts/package.mjs --platform win32 --arch x64",
    "pack:linux": "node scripts/package.mjs --platform linux --arch x64"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "motion": "^14.13.0",
    "pulsoicon-react": "^6.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "vite": "^8.3.8"
  }
}
