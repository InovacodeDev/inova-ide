{
  "name": "inova",
  "version": "0.12.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "bin": {
    "inova": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:deploy": "node scripts/deploy.mjs",
    "eloquent:up": "docker compose -f docker/eloquent/docker-compose.yml up -d",
    "eloquent:down": "docker compose -f docker/eloquent/docker-compose.yml down",
    "eloquent:logs": "docker compose -f docker/eloquent/docker-compose.yml logs -f ollama",
    "eloquent:pull": "docker compose -f docker/eloquent/docker-compose.yml run --rm ollama-init",
    "package:mac": "pnpm --filter @inova/desktop pack:mac",
    "package:win": "pnpm --filter @inova/desktop pack:win",
    "package:linux": "pnpm --filter @inova/desktop pack:linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
