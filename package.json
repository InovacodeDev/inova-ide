{
  "name": "inova",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "inova": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:deploy": "node scripts/deploy.mjs",
    "package:mac": "pnpm --filter @inova/desktop pack:mac",
    "package:win": "pnpm --filter @inova/desktop pack:win",
    "package:linux": "pnpm --filter @inova/desktop pack:linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}